# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). .env.local is git-ignored and never committed.
#
# The anon/public key is designed to be embedded in client apps -- it's safe here.
# Never put the "service_role" secret key in this file or anywhere client-side.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
